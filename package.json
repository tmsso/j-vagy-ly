{
  "name": "j-vagy-ly",
  "version": "0.1.0",
  "private": true,
  "description": "Hungarian j vs ly spelling practice web app",
  "author": "tmsso",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate-data": "python3 scripts/generate-pairs.py",
    "prebuild": "npm run generate-data",
    "test": "jest",
    "test:py": "python3 -m unittest discover -s tests",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:py && npm run build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "^1.1.21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tmsso/j-vagy-ly.git"
  }
}
